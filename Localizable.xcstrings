    "Sign in on your iPhone to share reports.": {},
    "Sign in to back up your logbook in the cloud and restore it on a new device. Passwords must be at least 8 characters.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich an, um dein Logbuch in der Cloud zu sichern und auf einem neuen Gerät wiederherzustellen. Passwörter müssen mindestens 8 Zeichen haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte-toi pour sauvegarder ton carnet dans le cloud et le restaurer sur un nouvel appareil. Les mots de passe doivent faire au moins 8 caractères."
          }
        }
      }
    },
