    "Off by default. Sharing sends flight summaries only — spot, date, duration and type. GPS tracks and notes never leave your device.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. Le partage n'envoie que des résumés de vol — spot, date, durée et type. Les traces GPS et les notes ne quittent jamais ton appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus. Geteilt werden nur Flug-Zusammenfassungen — Spot, Datum, Dauer und Typ. GPS-Tracks und Notizen verlassen nie dein Gerät."
          }
        }
      }
    },
