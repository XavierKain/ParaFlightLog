    "Auto-follow spots I fly": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivre auto. les spots où je vole"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geflogenen Spots automatisch folgen"
          }
        }
      }
    },
    "Auto-follow spots I fly subscribes you to condition reports at the spots you log, so nearby pilots' updates reach you. Alert me on flyable days schedules a local morning notification when tomorrow's forecast looks good at a spot you follow.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Suivre auto. les spots où je vole » t'abonne aux rapports de conditions des spots que tu enregistres, pour recevoir les mises à jour des pilotes proches. « Me prévenir les jours volables » programme une notification locale le matin quand les prévisions du lendemain s'annoncent bonnes sur un spot que tu suis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Geflogenen Spots automatisch folgen“ abonniert die Zustandsmeldungen der Spots, die du loggst, damit dich Updates anderer Piloten erreichen. „Bei fliegbaren Tagen benachrichtigen“ plant eine lokale Mitteilung am Morgen, wenn die Vorhersage für morgen an einem Spot, dem du folgst, gut aussieht."
          }
        }
      }
    },
    "Automatic Water Lock": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Water Lock automatique"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Wassersperre"
          }
        }
      }
    },
