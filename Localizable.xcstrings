    "⚠️ This action is irreversible! The wing \"%1$@\" and its ^[%2$lld flight](inflect: true) will be permanently deleted.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ This action is irreversible! The wing \"%1$@\" and its ^[%2$lld flight](inflect: true) will be permanently deleted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Cette action est irréversible ! La voile « %1$@ » et ses ^[%2$lld vol](inflect: true) seront définitivement supprimés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Diese Aktion ist unwiderruflich! Der Schirm „%1$@“ und seine ^[%2$lld Flug](inflect: true) werden endgültig gelöscht."
          }
        }
      }
    },
    "This wing has ^[%lld flight](inflect: true) recorded. Archiving keeps the data, deleting erases it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This wing has ^[%lld flight](inflect: true) recorded. Archiving keeps the data, deleting erases it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette voile totalise ^[%lld vol](inflect: true). L'archivage conserve les données, la suppression les efface."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Schirm hat ^[%lld Flug](inflect: true) aufgezeichnet. Archivieren behält die Daten, Löschen entfernt sie."
          }
        }
      }
    }
