    "Other pilots can see your flight line and replay it in 3D (simplified track). Forgot to stop a flight? Trim it from the flight page before it's shared.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres pilotes peuvent voir ta trace de vol et la rejouer en 3D (trace simplifiée). Oublié d'arrêter un vol ? Rogne-le depuis la page du vol avant qu'il soit partagé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Piloten sehen deine Fluglinie und können sie in 3D abspielen (vereinfachter Track). Flug vergessen zu stoppen? Kürze ihn auf der Flugseite, bevor er geteilt wird."
          }
        }
      }
    },
    "Oui": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes"
          }
