        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à nettoyer — la communauté ne contient que des vols encore présents dans votre carnet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts aufzuräumen — die Community enthält nur Flüge, die noch in deinem Flugbuch stehen."
          }
        }
      }
    },
