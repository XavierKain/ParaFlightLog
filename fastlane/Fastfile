# fastlane — SoarX (ParaFlightLog v20) → TestFlight
#
# Deux chemins d'upload, même destination :
#   • `beta`     — sur TON Mac. Signature AUTOMATIQUE (Xcode/ton trousseau).
#                  Le plus fiable pour un 1er upload. Il te faut juste la
#                  clé API App Store Connect (voir TESTFLIGHT_SETUP.md).
#   • `beta_ci`  — sur GitHub Actions (runner macOS, 1 clic). Signature
#                  AUTOMATIQUE via la clé API (pas de match).
#                  Appelée par .github/workflows/testflight.yml.
#
# Secrets / env attendus (voir TESTFLIGHT_SETUP.md) — les 4 mêmes pour les
# deux lanes :
#   ASC_KEY_ID         — ID de la clé API App Store Connect
#   ASC_ISSUER_ID      — Issuer ID (App Store Connect > Users > Integrations)
#   ASC_KEY_P8_BASE64  — contenu du .p8 encodé en base64
#   APPLE_TEAM_ID      — S96H22CQ8W

default_platform(:ios)

# Force UTF-8 : sinon xcpretty plante sur "invalid byte sequence in US-ASCII"
# (accents dans la sortie xcodebuild), le pipe `set -o pipefail` échoue et
# l'archive est tuée. Un shell macOS sans LANG/LC_ALL UTF-8 déclenche ça.
ENV["LANG"]   ||= "en_US.UTF-8"
ENV["LC_ALL"] ||= "en_US.UTF-8"

XCODEPROJ = "ParaFlightLog.xcodeproj"
SCHEME    = "ParaFlightLog"

# Cibles distribuées (chacune a besoin d'un profil App Store).
# Bundle ids = famille com.xavierkain.ParaFlightLog2 (celle de l'app déjà
# installée + registered avec Push/HealthKit). Le NOM affiché reste "SoarX".
APP_ID          = "com.xavierkain.ParaFlightLog2"
WIDGET_ID       = "com.xavierkain.ParaFlightLog2.FlightWidget"
WATCH_ID        = "com.xavierkain.ParaFlightLog2.watchkitapp"
WATCH_WIDGET_ID = "com.xavierkain.ParaFlightLog2.watchkitapp.ParaFlightLogWidgetExtension"
ALL_IDS = [APP_ID, WIDGET_ID, WATCH_ID, WATCH_WIDGET_ID].freeze

# ── Clé API App Store Connect (le .p8 vient d'un env base64) ─────────────
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
    is_key_content_base64: true
  )
end

# Build number unique et croissant : dernier TestFlight + 1 (fail-soft à 1).
def next_build_number(api_key)
  current = latest_testflight_build_number(
    api_key: api_key,
    app_identifier: APP_ID
  ) rescue 0
  current.to_i + 1
end

def ensure_app_record_exists(api_key)
  require "spaceship"
  key_path = File.expand_path("asc_key.p8") # gitignored (*.p8)
  File.write(key_path, Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64")))
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    filepath: key_path
  )
  return if Spaceship::ConnectAPI::App.find(APP_ID)
  UI.user_error!(<<~MSG)
    L'app n'existe pas encore dans App Store Connect (l'API Apple ne permet pas
    de la créer automatiquement). À faire UNE fois :
      1. https://appstoreconnect.apple.com > Apps > + > Nouvelle app
      2. Plateforme iOS, nom "SoarX", bundle ID #{APP_ID}, SKU "paraflightlog2"
         (si l'app existe déjà pour cet ID, rien à créer — elle sera réutilisée)
    Puis relance.
  MSG
rescue => e
  UI.important("Vérification app record ignorée (#{e.message}) — on continue.")
end

platform :ios do

  # ── LOCAL (Mac) : signature automatique ────────────────────────────────
  desc "Build signé + upload TestFlight depuis ton Mac (signature auto)"
  lane :beta do |options|
    api_key = asc_api_key
    ensure_app_record_exists(api_key)

    increment_build_number(
      build_number: options[:build_number] || next_build_number(api_key),
      xcodeproj: XCODEPROJ
    )

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      export_method: "app-store",
      # Signature auto : Xcode résout les profils de TOUTES les cibles
      # (app, widget iOS, watch app, widget watch) avec ton compte.
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: options[:changelog] || "Nouvelle version de test SoarX."
    )
    UI.success("✅ Envoyé sur TestFlight — dispo dans l'app TestFlight d'ici ~10-30 min.")
  end

  # ── CI (GitHub Actions) : signature AUTOMATIQUE via clé API ─────────────
  # Pas de match : la clé API App Store Connect + `-allowProvisioningUpdates`
  # laissent Xcode gérer certificat de distribution (cloud-managed) et profils
  # des 4 cibles sur le runner macOS. Aucun MATCH_PASSWORD ni repo de certs.
  desc "Build signé + upload TestFlight depuis GitHub Actions (signature auto)"
  lane :beta_ci do
    setup_ci
    api_key = asc_api_key
    ensure_app_record_exists(api_key)

    increment_build_number(
      build_number: next_build_number(api_key),
      xcodeproj: XCODEPROJ
    )

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
    UI.success("✅ Envoyé sur TestFlight — dispo dans l'app TestFlight d'ici ~10-30 min.")
  end

  desc "Infos version courante"
  lane :version_info do
    v = sh("cd .. && xcodebuild -project #{XCODEPROJ} -target #{SCHEME} -showBuildSettings 2>/dev/null | awk '/MARKETING_VERSION/{print $3; exit}'").strip
    b = sh("cd .. && xcodebuild -project #{XCODEPROJ} -target #{SCHEME} -showBuildSettings 2>/dev/null | awk '/CURRENT_PROJECT_VERSION/{print $3; exit}'").strip
    UI.message("📱 SoarX #{v} (build #{b})")
  end
end
